POSTGRES_USER=xxx
POSTGRES_PASSWORD=xxx
AIRFLOW_DB=xxx
DW_DB=xxx

# Jalur batch: batas ke belakang pipeline boleh menarik data historis (hari).
# 92 = maksimum parameter past_days Open-Meteo.
BACKFILL_MAX_DAYS=92

# Backfill jam yang pm2_5/pm10-nya masih NULL.
BACKFILL_MAX_ATTEMPTS=3
BACKFILL_RETRY_COOLDOWN_HOURS=24

# Minimal jam berisi pm2_5+pm10 dalam 30 hari agar DQ lolos.
DQ_MIN_ML_HOURS=24

# Jalur streaming (opsional). Interval simulator dalam detik, dan porsi pesan kotor (0 sampai 1).
SIM_INTERVAL_SECONDS=xxx
SIM_DIRTY_RATE=xxx