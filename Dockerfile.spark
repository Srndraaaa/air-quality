FROM python:3.12-slim-bookworm

RUN apt-get update \
    && apt-get install -y --no-install-recommends openjdk-17-jre-headless procps \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir --timeout 120 --retries 10 pyspark==4.2.0

# Jalur streaming: driver JDBC PostgreSQL dan psycopg2 untuk job di container spark-streaming.
RUN apt-get update \
    && apt-get install -y --no-install-recommends libpostgresql-jdbc-java \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --timeout 120 --retries 10 psycopg2-binary==2.9.10

ENV SPARK_NO_DAEMONIZE=true
WORKDIR /opt/project
